<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Eclipse crescent: teal light disc, dark bite to the upper-right.
         evenOdd cuts the inner circle, letting the background show through. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M50,56 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 M64,44 m-24,0 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24" android:startY="30"
                android:endX="80" android:endY="84">
                <item android:offset="0.0" android:color="#FF3BEBC9" />
                <item android:offset="1.0" android:color="#FF10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Scan dot — top-right accent -->
    <path
        android:fillColor="#FF00E5C8"
        android:pathData="M74,34 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />

</vector>
